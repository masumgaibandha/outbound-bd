# =============================================================================
# Required Production Config
# Every value below must be set in Production. No secret, just configuration.
# =============================================================================

# MongoDB connection string (used by Mongoose for the agency site, and via
# the src/lib/masterclass/db.ts shim for the masterclass feature's own
# collections — same connection, same database, no second cluster).
MONGODB_URI=mongodb://127.0.0.1:27017/outbound-bd

# Public app URL — used for metadataBase, sitemap.xml, robots.txt, and
# canonical/OpenGraph URLs across the whole site.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated, no spaces required (whitespace is trimmed). Production
# MUST be exactly the two real domains below — never include localhost in
# Production. Local dev may add http://localhost:3000 to its own value.
MASTERCLASS_ALLOWED_ORIGINS=https://outboundbd.com,https://www.outboundbd.com

# Master switch for the registration feature. The literal string "true"
# enables it; anything else (including unset) leaves registration visibly
# closed and the API safely rejecting. Do not enable in Production during
# Phase 1 — see the phase report for the manual cutover checklist.
MASTERCLASS_REGISTRATION_ENABLED=false

# The public Turnstile site key rendered by the client widget. Cloudflare's
# official test site key (1x00000000000000000000AA) is fine here in local
# dev/test only — see the Local-Test-Only section below. Production must be
# a real Cloudflare Turnstile site key or the registration route fails
# closed (see TURNSTILE_SECRET_KEY below for why).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# =============================================================================
# Required Production Secret
# Every value below is a real credential. Never commit a filled-in value.
# =============================================================================

# HMAC key for the masterclass's keyed-hash rate limiter (IP/email are
# hashed with this before being stored — never stored raw). The value
# previously used here was exposed and has been rotated; generate a new
# random value (e.g. `openssl rand -base64 32`) for every environment and
# never reuse a value that has ever been committed, logged, or shared.
MASTERCLASS_RATE_LIMIT_SECRET=

# Server-side Turnstile secret, verified against Cloudflare's Siteverify
# endpoint on every registration/payment submission. Cloudflare's official
# test secret keys (1x.../2x.../3x...0000000000000000000000000000000AA) are
# fine in local dev/test only — see Local-Test-Only below. If Production is
# ever left on one of those test keys (this one, or a test
# NEXT_PUBLIC_TURNSTILE_SITE_KEY above), src/lib/masterclass/env.ts's
# getSecurityEnv() deliberately returns null and the registration/payment
# routes respond exactly as if registration were disabled (503) — a
# misconfigured production deploy can never accept a fake-verified
# submission; it just looks closed from the outside.
TURNSTILE_SECRET_KEY=

# HTTP Basic Auth credentials for the masterclass-only admin order-review
# surface at /masterclass/admin/orders. Not the removed general agency
# dashboard — this protects only that one small, masterclass-specific page.
# Both must be set or every request to that route is rejected (fails
# closed, never a default credential).
MASTERCLASS_ADMIN_USER=
MASTERCLASS_ADMIN_PASSWORD=

# Manual mobile-payment numbers shown to a registrant during checkout, one
# per method. Not committed to Git, but note these are configuration a
# paying registrant is always shown on-screen in order to send payment —
# they are not secrets in the security sense (leaking one only reveals a
# public-facing payment number, the same one already shown to any
# registrant), just credentials this file keeps out of source control like
# everything else here. Any method left unset is simply hidden from the
# payment picker rather than presenting a broken option.
MASTERCLASS_BKASH_NUMBER=
MASTERCLASS_NAGAD_NUMBER=
MASTERCLASS_ROCKET_NUMBER=

# Resend transactional email. RESEND_FROM_EMAIL/RESEND_REPLY_TO_EMAIL are
# each a single-line string, either a bare address or "Name <email>" (e.g.
# "Outbound BD <hello@outboundbd.com>") — both must resolve to a domain
# verified in the Resend dashboard before Production can send real mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# =============================================================================
# Optional analytics variable
# Marketing-attribution only. Absent (any one missing) means Pixel/CAPI
# tracking cleanly disables itself — nothing throws, nothing blocks a
# render or a registration. NEXT_PUBLIC_META_PIXEL_ID and META_PIXEL_ID
# must be the same Pixel ID (src/lib/masterclass/env.ts's
# verifyMetaPixelIdsMatch() checks this) or events end up split across two
# different Pixels. META_CAPI_ACCESS_TOKEN is server-only and must never be
# exposed to the client bundle.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# =============================================================================
# Local-test-only value
# Never set these in Production — see the production-rejection note on
# TURNSTILE_SECRET_KEY above. Safe to use in local dev and in the automated
# test suite, where no real visitor is ever being verified.
# =============================================================================

# Cloudflare's official Turnstile test keypair — the site key always passes
# an interactive visible challenge, the secret key always verifies it as
# valid. See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
