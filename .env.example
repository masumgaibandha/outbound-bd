# MongoDB connection string (used by both Better Auth and Mongoose)
MONGODB_URI=mongodb://127.0.0.1:27017/outbound-bd

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public app URL, used by the client-side auth client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (private store for payment-proof uploads/reads)
# Create a Blob store in the Vercel dashboard and copy its read/write token.
# Required for POST /api/orders/[orderId]/payments and the proof-viewing
# routes — never commit a real token here.
BLOB_READ_WRITE_TOKEN=
